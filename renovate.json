{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard"
    ],
    "assignees": [
        "narthollis"
    ],
    "reviewers": [
        "narthollis"
    ],
    "assignAutomerge": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/kustomization.yaml/"
            ],
            "matchStrings": [
                "https://github\\.com/(?<depName>.*/.*?)/releases/download/(?<currentValue>.*?)/"
            ],
            "datasourceTemplate": "github-releases"
        }
    ],
    "argocd": {
        "managerFilePatterns": [
            "/\\.application\\.yaml$/"
        ]
    },
    "packageRules": [
        {
            "matchPackageNames": ["rook-ceph", "rook-ceph-cluster"],
            "separateMinorPatch": true
        },
        {
            "matchPackageNames": [
                "ghcr.io/dictionarry-hub/profilarr",
                "ghcr.io/dictionarry-hub/profilarr-parser"
            ],
            "groupName": "profilarr"
        },
        {
            "matchPackageNames": ["lscr.io/linuxserver/lidarr"],
            "allowedVersions": "<8.0.0"
        },
        {
            "matchPackageNames": ["ghcr.io/narthollis/net_narthollis_www"],
            "pinDigests": true
        }
    ]
}
